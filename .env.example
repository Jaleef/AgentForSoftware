# ============================================================
# 开发环境 LLM 配置
# 仅在 NODE_ENV=development 时加载（pnpm dev 会自动设置）。
# 修改后请重启 `pnpm dev`。
#
# 部署环境（pnpm build && pnpm start）不会读取本文件，
# 请使用「设置 → 模型服务」页面配置模型。
# 本文件已被 .gitignore 忽略，不要把真实 Key 提交到仓库。
# ============================================================

# OpenAI Chat Completions 兼容地址：
# DeepSeek:   https://api.deepseek.com

LLM_BASE_URL=https://api.deepseek.com

LLM_API_KEY=

LLM_MODEL=deepseek-chat
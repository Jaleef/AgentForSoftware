# ============================================================
# 开发环境 LLM 配置
# 仅在 NODE_ENV=development 时加载（pnpm dev 会自动设置）。
# 修改后请重启 `pnpm dev`。
#
# 部署环境（pnpm build && pnpm start）不会读取本文件，
# 请使用「设置 → 模型服务」页面配置模型。
# 本文件已被 .gitignore 忽略，不要把真实 Key 提交到仓库。
# ============================================================

# OpenAI Chat Completions 兼容地址：
# DeepSeek:   https://api.deepseek.com

LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-flash
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096
# 拆分并发；DeepSeek 建议 6，遇到 429 降到 4-5
LLM_CONCURRENCY=6
LLM_TIMEOUT_MS=120000
LLM_JSON_MODE=true
LLM_MOCK=false

# 子系统分类：auto=先章节路径，质量差时自动用 LLM（默认）；heuristic=只用章节；llm=强制 LLM
# LLM_TAXONOMY=auto

# ============================================================
# 可选：语义召回（Embedding）
# 不配置时，检索自动使用 BM25F + 原词面通道。
# 需要 OpenAI 兼容的 /embeddings 接口。
# ============================================================

EMBEDDING_MODEL=bge-m3
EMBEDDING_BASE_URL=http://127.0.0.1:8000/v1
EMBEDDING_API_KEY=local-key
EMBEDDING_BATCH_SIZE=32
EMBEDDING_TIMEOUT_MS=60000

# 可选：Cross-Encoder 重排
# 通用服务默认 POST {RERANK_BASE_URL}/rerank；
# 阿里云 MaaS 会自动改用 /compatible-api/v1/reranks。
# 特殊路径可显式设置 RERANK_PATH（如 /reranks）。
RERANK_MODEL=bge-reranker-v2-m3
RERANK_BASE_URL=http://127.0.0.1:8001/v1
RERANK_API_KEY=
RERANK_TIMEOUT_MS=60000
# RERANK_PATH=/reranks